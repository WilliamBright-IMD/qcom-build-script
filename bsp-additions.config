CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
# USB_DWC3_QCOM has `depends on USB_QCOM_EUD || !USB_QCOM_EUD`, so it cannot be
# built-in (=y) while EUD is a module. The defconfig sets USB_QCOM_EUD=m, which
# silently demotes USB_DWC3_QCOM to =m -> the UDC driver is never loaded and no
# UDC appears, so the ADB/RNDIS gadget never binds. Force EUD built-in too.
CONFIG_USB_QCOM_EUD=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
# Ethernet
CONFIG_LAN743X=y
# TSD
CONFIG_DRM_PANEL_TSD_TST070WSBE_196C=m
# Panel driver
CONFIG_BACKLIGHT_GPIO=y

